<script>
  // Popups
  const eq = document.getElementById('dlg-eq') as HTMLDialogElement | null;
  const brief = document.getElementById('dlg-brief') as HTMLDialogElement | null;
  document.querySelectorAll('.js-open-eq').forEach((b) => b.addEventListener('click', () => eq?.showModal()));
  document.querySelectorAll('.js-open-brief').forEach((b) => b.addEventListener('click', () => brief?.showModal()));
  document.querySelectorAll('.inv-dialog').forEach((d) => {
    const dlg = d as HTMLDialogElement;
    dlg.querySelector('.dlg-close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  });
  const briefForm = document.getElementById('brief-form') as HTMLFormElement | null;
  const briefMsg = document.getElementById('brief-msg');
  briefForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (briefMsg) briefMsg.hidden = false;
  });
  brief?.addEventListener('close', () => {
    briefForm?.reset();
    if (briefMsg) briefMsg.hidden = true;
  });

  // Hero video: swap poster for the Vimeo player on click
  document.querySelectorAll<HTMLElement>('.video-poster').forEach((box) => {
    box.querySelector('.play')?.addEventListener('click', () => {
      const src = box.dataset.vimeo;
      if (!src) return;
      const f = document.createElement('iframe');
      f.src = src;
      f.allow = 'autoplay; fullscreen';
      f.allowFullscreen = true;
      f.title = 'RoboBurger video';
      box.replaceChildren(f);
    });
  });

  // Revolution video: load the Vimeo player when it scrolls into view
  const cover = document.querySelector<HTMLIFrameElement>('.video-cover iframe');
  if (cover && 'IntersectionObserver' in window) {
    new IntersectionObserver((entries, obs) => {
      if (entries.some((en) => en.isIntersecting)) {
        cover.src = cover.dataset.src || '';
        obs.disconnect();
      }
    }, { rootMargin: '200px' }).observe(cover);
  }

  // Logo carousels: advance one slide every 5s with a 0.5s ease (matches the original)
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.car-track');
    if (!track) return;
    const total = track.children.length;
    const slides = Number(root.dataset.slides || 5);
    const gap = Number(root.dataset.gap || 0);
    const unique = total / (root.classList.contains('carousel-media') ? 3 : 2);
    let i = 0;
    let timer: number | undefined;
    const step = () => (track.children[0] as HTMLElement).getBoundingClientRect().width + gap;
    const go = () => {
      i += 1;
      track.style.transition = 'transform 500ms ease';
      track.style.transform = `translateX(${-i * step()}px)`;
      if (i >= unique) {
        window.setTimeout(() => {
          track.style.transition = 'none';
          i = 0;
          track.style.transform = 'translateX(0)';
        }, 520);
      }
    };
    const start = () => { timer = window.setInterval(go, 5000); };
    const stop = () => { if (timer) window.clearInterval(timer); };
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    start();
    void slides;
  });
</script>

