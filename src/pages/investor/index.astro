---
import BaseLayout from '../../layouts/BaseLayout.astro';

const I = '/images/roboburger/';
const STARTENGINE =
  'https://www.startengine.com/offering/roboburger?utm_source=landing_homepage&utm_medium=referral&utm_campaign=roboburger_invest';

const reasons = [
  {
    icon: 'invest-icon-01.svg',
    title: 'The Product: Proprietary Tech Meets Chef-Quality Dining',
    text: 'RoboBurger is a technological marvel protected by patents and full safety certifications. It is one of the only machines that grills fresh, chef-quality burgers on demand, featuring a flexible menu of 3 patty types and 9 customizable toppings and sauces for a gourmet experience in minutes.',
  },
  {
    icon: 'invest-icon-02.svg',
    title: 'The Opportunity: Dominating a Massive Market',
    text: 'We are targeting the $868B fast-food industry and the food automation sector. As one of the world’s only fully autonomous burger solutions, we believe we hold a competitive advantage to capture this market as demand for efficient, labor-free food technology reaches an all-time high.',
  },
  {
    icon: 'invest-icon-03.svg',
    title: 'The Execution: Commercial Launch and Strategic Scale',
    text: 'After years of development, 2026 marks our commercial phase The Company has partnered with Sweet Robo LLC, which has experience deploying automated retail systems internationally. Through this relationship, RoboBurger has access to manufacturing, supply chain, and operational expertise intended to support its commercialization efforts.',
  },
];

const market = [
  { icon: 'invest-icon-04.svg', title: 'MARKET SIZE', text: 'Americans consume 50B burgers annually. $868B global fast-food market.' },
  { icon: 'invest-icon-05.svg', title: 'LABOR CHALLENGES', text: '70% of restaurants face staffing shortages. Rising labor costs squeeze profitability.' },
  { icon: 'invest-icon-06.svg', title: 'CONSUMER DEMANDS', text: 'Expectations for hot, fresh food anytime. Consumers want speed without compromise.' },
  { icon: 'invest-icon-07.svg', title: 'AUTOMATION MOMENTUM', text: '70% of consumers open to automated service. Confidence in tech-driven dining is growing.' },
];

const money = [
  { icon: 'invest-icon-08.svg', title: 'Machine Sales', text: 'High-margin units sold to retail, entertainment, and institutional venues.' },
  { icon: 'invest-icon-09.svg', title: 'Global Distribution', text: 'Regional partners expanding across international market.' },
  { icon: 'invest-icon-10.svg', title: 'Consumables', text: 'Recurring revenue from proprietary patties, buns, sauces, and packaging.' },
  { icon: 'invest-icon-11.svg', title: 'Custom-Branded Machines', text: 'Co-branded units with major food and retail brands.' },
  { icon: 'invest-icon-12.svg', title: 'Software Subscriptions', text: 'Monthly fees for remote monitoring, inventory, and performance data.' },
  { icon: 'invest-icon-13.svg', title: 'Entrepreneur Partners', text: 'Trained individuals running their own RoboBurger units.' },
  { icon: 'invest-icon-14.svg', title: 'Service & Parts', text: 'Revenue from maintenance contracts and replacement components.' },
  { icon: 'invest-icon-15.svg', title: 'Company-Operated Units', text: 'Direct burger sales from high-traffic locations.' },
  { icon: 'invest-icon-16.svg', title: 'Leasing & Financing', text: 'Flexible options generating predictable monthly cash flow' },
];

const whyNow = [
  {
    icon: 'invest-icon-17.svg',
    title: 'Massive Overhead Reduction',
    text: 'We eliminate the two biggest expenses: labor and expensive real estate. RoboBurger can be placed in high-traffic locations like airports, hospitals, and universities where a traditional kitchen simply wouldn’t be viable.',
  },
  {
    icon: 'invest-icon-18.svg',
    title: 'Unmatched Market Readiness',
    text: 'As we enter 2026, we are backed by thousands of inquiries from global operators. This isn’t just a concept; the market is actively seeking this technology to solve the global food service crisis.',
  },
  {
    icon: 'invest-icon-19.svg',
    title: 'The "Kitchen-as-a-Platform" Model',
    text: 'Unlike static vending machines, our tech allows for a flexible menu and rapid deployment. We can scale across continents at a fraction of the cost of traditional franchises, making us the most agile player in the industry.',
  },
];

const scaleCards = [
  { icon: 'invest-icon-20.svg', text: 'Trusted by top global brands, with active partnerships across leading retail, entertainment, and hospitality sectors.' },
  { icon: 'invest-icon-21.svg', text: 'Developed 15+ groundbreaking machines, from cotton candy to ice cream - pushing the limits of automated retail.' },
  { icon: 'invest-icon-22.svg', text: 'Powered by dozens of top-tier engineers, developers, designers, and tech specialists.' },
  { icon: 'invest-icon-23.svg', text: 'Thousands of machines sold in 25+ countries, serving millions of customers worldwide.' },
];

const partnerLogos = Array.from({ length: 14 }, (_, i) => `${I}invest-Frame-${54 + i}.svg`);
const mediaLogos = Array.from({ length: 6 }, (_, i) => `${I}invest-Frame-${68 + i}.svg`);

const strategic = [
  { title: 'Manufacturing & Infrastructure', text: 'Direct access to Sweet Robo’s established factories and logistics networks.' },
  { title: 'Global Distribution', text: 'A ready-made network of international distributors and offices.' },
  { title: 'Operational Excellence', text: 'Proven technical support and a seamless operations system.' },
  { title: 'Elite Client Access', text: 'A direct bridge to some of the world\'s largest commercial customers.' },
];

const proof = [
  { icon: 'invest-icon-25.svg', html: '<b>$7M+ raised</b> across prior funding rounds, backed by leading VC and angel investors' },
  { icon: 'invest-icon-26.svg', html: 'Featured in <b>Forbes, TechCrunch, NY Post,</b> and dozens of other prominent outlets' },
  { icon: 'invest-icon-27.svg', html: 'Over <b>4.4 billion global media impressions</b>' },
  { icon: 'invest-icon-28.svg', html: '<b>More than $38M</b> in earned media value' },
];

const DISCLAIMER_IMG =
  '*Image shown may include digital enhancements or illustrative elements. Visuals are based on the RoboBurger system but may not represent the exact appearance of deployed units.';
const DISCLAIMER_IMGS =
  '*Images shown may include digital enhancements or illustrative elements. Visuals are based on the RoboBurger system but may not represent the exact appearance of deployed units.';
---

<BaseLayout
  title="The Robotic Burger Chef Disrupting a $868B Industry"
  description="Invest in one of the first and only fully autonomous burger machines that grills and serves fresh, hot burgers on demand."
  bare
>
  <!-- HEADER -->
  <header class="inv-header">
    <div class="inv-header-inner">
      <a href="/" class="inv-logo" aria-label="RoboBurger home">
        <img src={`${I}invest-Logo-10.svg`} alt="RoboBurger" width="60" height="45" />
      </a>
      <button type="button" class="inv-eq-link js-open-eq">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg>
        <span>What is equity crowdfunding?</span>
      </button>
      <button type="button" class="btn js-open-brief">Download our investor brief</button>
    </div>
  </header>

  <!-- 1 HERO -->
  <section class="sec hero" style="--z:18">
    <div class="wrap">
      <div class="hero-top">
        <a href={STARTENGINE} target="_blank" rel="noopener" class="se-link"><span>See RoboBurger on StartEngine</span></a>
      </div>
      <div class="hero-row">
        <div class="hero-copy">
          <h1>The Robotic Burger Chef Disrupting a $868B Industry</h1>
          <p class="hero-lead">Invest in one of the first and only fully autonomous burger machines that grills and serves fresh, hot burgers on demand.</p>
          <button type="button" class="btn js-open-brief">Download our investor brief</button>
        </div>
        <div class="hero-media">
          <div class="video-poster" data-vimeo="https://player.vimeo.com/video/1180480814?autoplay=1&playsinline=1&color&autopause=0&loop=0&muted=0&title=1&portrait=1&byline=1">
            <img src={`${I}invest-hero-poster.webp`} alt="RoboBurger machine — Closing soon" width="1800" height="1013" />
            <button type="button" class="play" aria-label="Play video"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg></button>
          </div>
        </div>
      </div>
    </div>
    <div class="wave wave-hero" aria-hidden="true">
      <svg viewBox="0 0 1000 100" preserveAspectRatio="none"><path fill="#F5DCDD" d="M421.9,6.5c22.6-2.5,51.5,0.4,75.5,5.3c23.6,4.9,70.9,23.5,100.5,35.7c75.8,32.2,133.7,44.5,192.6,49.7c23.6,2.1,48.7,3.5,103.4-2.5c54.7-6,106.2-25.6,106.2-25.6V0H0v30.3c0,0,72,32.6,158.4,30.5c39.2-0.7,92.8-6.7,134-22.4c21.2-8.1,52.2-18.2,79.7-24.2C399.3,7.9,411.6,7.5,421.9,6.5z"></path></svg>
    </div>
  </section>

  <!-- 2 REASONS TO INVEST -->
  <section class="sec reasons" style="--z:17">
    <div class="wrap">
      <h2 class="h-center h42">Reasons to Invest</h2>
      <div class="cols-3">
        {reasons.map((r) => (
          <div class="col-card">
            <img class="ico" src={I + r.icon} alt="" width="66" height="66" />
            <h4 class="col-title">{r.title}</h4>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 THE MARKET -->
  <section class="sec market" style="--z:16">
    <div class="wrap">
      <h2 class="h46">The Market</h2>
      <h1 class="h46">A $868B Market Starved For Disruption</h1>
      <div class="market-row">
        <div class="market-pills">
          {market.map((m) => (
            <div class="pill-line">
              <img class="ico" src={I + m.icon} alt="" width="66" height="66" />
              <div>
                <h4>{m.title}</h4>
                <p>{m.text}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="market-phone">
          <img src={`${I}invest-market-phone.webp`} alt="RoboBurger machine" width="489" height="596" loading="lazy" />
        </div>
      </div>
      <p class="note note-light">{DISCLAIMER_IMG} *868BN Market Source Here – The market size is expected to reach this in 2030.</p>
      <div class="btn-row"><button type="button" class="btn js-open-brief">Download our investor brief</button></div>
    </div>
    <div class="wave wave-tall" aria-hidden="true">
      <svg viewBox="0 0 1000 100" preserveAspectRatio="none"><path fill="#ffffff" d="M421.9,6.5c22.6-2.5,51.5,0.4,75.5,5.3c23.6,4.9,70.9,23.5,100.5,35.7c75.8,32.2,133.7,44.5,192.6,49.7c23.6,2.1,48.7,3.5,103.4-2.5c54.7-6,106.2-25.6,106.2-25.6V0H0v30.3c0,0,72,32.6,158.4,30.5c39.2-0.7,92.8-6.7,134-22.4c21.2-8.1,52.2-18.2,79.7-24.2C399.3,7.9,411.6,7.5,421.9,6.5z"></path></svg>
    </div>
  </section>

  <!-- 4 IT'S A REVOLUTION -->
  <section class="sec revolution" style="--z:15">
    <div class="wrap">
      <h1 class="h68"><span class="red">IT'S A </span>REVOLUTION</h1>
      <div class="revolution-gap"></div>
      <p class="note note-dark jakarta">{DISCLAIMER_IMGS}</p>
      <h2 class="h68 h68-b">A FULLY AUTOMATED <span class="red">BURGER KITCHEN IN JUST 10 sq ft</span></h2>
      <div class="video-cover">
        <iframe
          data-src="https://player.vimeo.com/video/1180476433?autoplay=1&playsinline=1&color&autopause=0&loop=0&muted=0&title=1&portrait=1&byline=1"
          title="RoboBurger — a fully automated burger kitchen"
          allow="autoplay; fullscreen"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
      <p class="note note-dark jakarta">*Video shown may include digital enhancements or illustrative elements. Visuals are based on the RoboBurger system but may not represent the exact appearance of deployed units.</p>
      <div class="btn-row"><button type="button" class="btn js-open-brief">Download our investor brief</button></div>
    </div>
  </section>

  <!-- 5 ABOUT US -->
  <section class="sec about" style="--z:14">
    <div class="about-ovl" aria-hidden="true"></div>
    <div class="wrap about-wrap">
      <div class="about-copy">
        <h2 class="h42">About Us</h2>
        <p>We’re on a mission to make fast food as you know it obsolete. We’re turning empty corners into high-profit food destinations. We’re creating a future where fresh, hot food is delivered reliably, 24/7. We’ve patented the technology. We’ve proven demand. And now you have the opportunity to invest at a critical moment and join us as we scale.</p>
        <button type="button" class="btn js-open-brief">Download our investor brief</button>
      </div>
    </div>
    <div class="wave wave-tall" aria-hidden="true">
      <svg viewBox="0 0 1000 100" preserveAspectRatio="none"><path fill="#000000" d="M421.9,6.5c22.6-2.5,51.5,0.4,75.5,5.3c23.6,4.9,70.9,23.5,100.5,35.7c75.8,32.2,133.7,44.5,192.6,49.7c23.6,2.1,48.7,3.5,103.4-2.5c54.7-6,106.2-25.6,106.2-25.6V0H0v30.3c0,0,72,32.6,158.4,30.5c39.2-0.7,92.8-6.7,134-22.4c21.2-8.1,52.2-18.2,79.7-24.2C399.3,7.9,411.6,7.5,421.9,6.5z"></path></svg>
    </div>
  </section>

  <!-- 6 THE PROBLEM / THE SOLUTION -->
  <section class="sec problem" style="--z:13">
    <div class="problem-ovl" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="h-center h42">The Problem</h2>
      <h4 class="problem-text">The traditional fast-food industry is hitting a wall. Rising labor costs, massive staff shortages, and the high overhead of maintaining a full-scale kitchen are eating away at profit margins. Restaurants are struggling to stay consistent, fast, and profitable.</h4>
      <div class="solution-card">
        <h2 class="h42">The Solution</h2>
        <p>RoboBurger is the answer to the <a href="https://finance.yahoo.com/news/fast-food-industry-report-2026-150600688.html" target="_blank" rel="noopener">$868B industry’s</a> biggest headache. We have condensed an entire commercial kitchen into a compact, fully autonomous, 7-patented machine. It doesn’t just reheat food; it grills fresh, chef-quality burgers from scratch in minutes—with zero human error, and a 24/7 uptime.</p>
        <button type="button" class="btn js-open-brief">Download our investor brief</button>
      </div>
    </div>
  </section>

  <!-- 7 HOW ROBOBURGER PLANS TO MAKE MONEY -->
  <section class="sec money" style="--z:12">
    <div class="money-ovl" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="h-center h42 white">How RoboBurger Plans to Make Money</h2>
      <div class="cols-3 money-grid">
        {money.map((m) => (
          <div class="money-card">
            <img class="ico ico-sm" src={I + m.icon} alt="" width="48" height="48" />
            <h4>{m.title}</h4>
            <p>{m.text}</p>
          </div>
        ))}
      </div>
      <div class="btn-row"><button type="button" class="btn js-open-brief">Download our investor brief</button></div>
    </div>
  </section>

  <!-- 8 TOTAL ADDRESSABLE MARKET -->
  <section class="sec tam" style="--z:11">
    <div class="wrap">
      <h2 class="h42">TOTAL ADDRESSABLE MARKET BY VERTICAL</h2>
      <p>Below is a breakdown of our estimated TAM by vertical and region. Sources: U.S. Census Bureau – County Business Patterns (CBP 2022 &amp; 2023).</p>
      <img class="tam-img" src={`${I}invest-tam.webp`} alt="Total addressable market by vertical" width="1140" height="824" loading="lazy" />
    </div>
    <div class="wave wave-xtall" aria-hidden="true">
      <svg viewBox="0 0 1000 100" preserveAspectRatio="none"><path fill="#FCF2F2" d="M421.9,6.5c22.6-2.5,51.5,0.4,75.5,5.3c23.6,4.9,70.9,23.5,100.5,35.7c75.8,32.2,133.7,44.5,192.6,49.7c23.6,2.1,48.7,3.5,103.4-2.5c54.7-6,106.2-25.6,106.2-25.6V0H0v30.3c0,0,72,32.6,158.4,30.5c39.2-0.7,92.8-6.7,134-22.4c21.2-8.1,52.2-18.2,79.7-24.2C399.3,7.9,411.6,7.5,421.9,6.5z"></path></svg>
    </div>
  </section>

  <!-- 9 WHY NOW -->
  <section class="sec whynow" style="--z:10">
    <div class="wrap">
      <h2 class="h42">Why Now?</h2>
      <div class="cols-3">
        {whyNow.map((w) => (
          <div class="col-card">
            <img class="ico" src={I + w.icon} alt="" width="66" height="66" />
            <h4 class="col-title red">{w.title}</h4>
            <p>{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10 THE VISION -->
  <section class="sec vision" style="--z:9">
    <div class="wrap">
      <h2 class="h42">The Vision</h2>
      <p>We aren’t just selling a machine; we are selling the operating system of future dining. While others are trying to automate parts of the kitchen, we have replaced the kitchen entirely. We believe we are here to scale into a dominant autonomous burger empire.</p>
      <img class="poster-img" src={`${I}invest-vision.webp`} alt="Pilot success, global demand, enterprise talks" width="1140" height="640" loading="lazy" />
      <p class="note note-light">{DISCLAIMER_IMG}</p>
      <div class="btn-row"><button type="button" class="btn js-open-brief">Download our investor brief</button></div>
    </div>
  </section>

  <!-- 11 GLOBAL SCALE -->
  <section class="sec scale" style="--z:8">
    <div class="wrap">
      <h2 class="h-center h42 navy">Global Scale</h2>
      <h1 class="h68"><span>NEW PARTNERSHIP </span><span class="red">WITH SWEET ROBO</span></h1>
      <p class="center">RoboBurger has joined forces with Sweet Robo – the largest leader in robotics vending. This partnership brings proven scale, deep technical resources, and a global track record in automated vending.</p>
      <img class="collage" src={`${I}invest-collage.webp`} alt="Sweet Robo machines" width="1037" height="644" loading="lazy" />
      <div class="carousel" data-carousel data-slides="5" data-gap="0">
        <div class="car-track">
          {[...partnerLogos, ...partnerLogos].map((src) => (
            <div class="car-slide"><img src={src} alt="" width="159" height="54" loading="lazy" /></div>
          ))}
        </div>
      </div>
      <h2 class="h68 h68-b"><span>3 WAREHOUSES, 4 OFFICES, 5 MANUFACTURING FACILITIES, </span><span class="red">AND OVER 200 GLOBAL EMPLOYEES</span></h2>
      <p class="center">all ready to scale RoboBurger to the next level.</p>
      <div class="scale-grid">
        {scaleCards.map((c) => (
          <div class="scale-card">
            <img class="ico ico-sm" src={I + c.icon} alt="" width="48" height="48" loading="lazy" />
            <p>{c.text}</p>
          </div>
        ))}
      </div>
      <div class="btn-row"><button type="button" class="btn js-open-brief">Download our investor brief</button></div>
    </div>
  </section>

  <!-- 12 STRATEGIC PARTNERSHIP -->
  <section class="sec strategic" style="--z:7">
    <div class="wrap">
      <h2 class="h42">Strategic Partnership</h2>
      <h1 class="h64">Built for Global Scale</h1>
      <p>Since 2025, RoboBurger has been powered by a strategic partnership with SweetRobo*, a global leader in food automation. With thousands of machines already deployed across dozens of countries, SweetRobo brings a proven track record and a high-profile client roster, including industry giants such as IKEA, Universal Studios, Sheraton Hotels, Hershey’s Park, Simon Properties and Aramark. Accelerating Towards Dominance: This partnership provides RoboBurger with immediate access to a world-class ecosystem, making our rollout faster and more professional. Through SweetRobo, we leverage:</p>
      <div class="strat-grid">
        {strategic.map((s) => (
          <div class="strat-card">
            <div class="strat-inner">
              <img class="ico ico-sm" src={`${I}invest-icon-24.svg`} alt="" width="48" height="48" loading="lazy" />
              <h5>{s.title}</h5>
              <p>{s.text}</p>
            </div>
          </div>
        ))}
      </div>
      <p>By aligning with the best player in the automation industry, we aren’t just launching a product, we are scaling a proven global operation.</p>
      <div class="disclosure">
        <p class="note note-light">Disclosure:</p>
        <p class="note note-light">*RoboBurger began development under RoboBurger Enterprises, which built the early prototypes, secured intellectual property, and appeared on Shark Tank. In 2025, RoboBurger Inc. was formed as a joint venture with Sweet Robo to commercialize and scale the next-generation RoboBurger platform. Sweet Robo is a principal security holder of the company and also engaged via a Services Agreement.</p>
      </div>
      <img class="poster-img" src={`${I}invest-strategic.webp`} alt="" width="1140" height="640" loading="lazy" />
      <p class="note note-light">{DISCLAIMER_IMGS}</p>
      <div class="btn-row"><button type="button" class="btn js-open-brief">Download our investor brief</button></div>
    </div>
  </section>

  <!-- 13 SOCIAL PROOF -->
  <section class="sec social" style="--z:6">
    <div class="wrap">
      <h1 class="h64">Sharks, Media, and Diners Keep Biting</h1>
      <p>Robo Burger has already caught the attention of both the press and prominent backers, and the momentum just keeps on building.</p>
      <div class="social-row">
        <div class="proof-list">
          {proof.map((p) => (
            <div class="proof-pill">
              <img class="ico ico-sm" src={I + p.icon} alt="" width="48" height="48" loading="lazy" />
              <p set:html={p.html} />
            </div>
          ))}
        </div>
        <div class="proof-imgs">
          <img src={`${I}invest-social-a.webp`} alt="" width="360" height="240" loading="lazy" />
          <img src={`${I}invest-social-b.webp`} alt="" width="360" height="240" loading="lazy" />
        </div>
      </div>
      <div class="carousel carousel-media" data-carousel data-slides="6" data-gap="22">
        <div class="car-track">
          {[...mediaLogos, ...mediaLogos, ...mediaLogos].map((src) => (
            <div class="car-slide"><img src={src} alt="" width="125" height="54" loading="lazy" /></div>
          ))}
        </div>
      </div>
      <p class="note note-light small-note">* The data reference RoboBurger Enterprises, the predecessor entity, since the issuer is RoboBurger Inc. (2025)</p>
      <img class="poster-img" src={`${I}invest-social.webp`} alt="" width="1140" height="640" loading="lazy" />
      <p class="note note-light">Testimonials from Shark Tank cast members reflect personal opinions and do not constitute an endorsement of the current offering. Please review the full offering circular on StartEngine before investing.</p>
      <div class="btn-row"><button type="button" class="btn js-open-brief">Download our investor brief</button></div>
    </div>
    <div class="wave wave-tall2" aria-hidden="true">
      <svg viewBox="0 0 1000 100" preserveAspectRatio="none"><path fill="#ffffff" d="M421.9,6.5c22.6-2.5,51.5,0.4,75.5,5.3c23.6,4.9,70.9,23.5,100.5,35.7c75.8,32.2,133.7,44.5,192.6,49.7c23.6,2.1,48.7,3.5,103.4-2.5c54.7-6,106.2-25.6,106.2-25.6V0H0v30.3c0,0,72,32.6,158.4,30.5c39.2-0.7,92.8-6.7,134-22.4c21.2-8.1,52.2-18.2,79.7-24.2C399.3,7.9,411.6,7.5,421.9,6.5z"></path></svg>
    </div>
  </section>

  <!-- 14 INVEST IN ROBOBURGER -->
