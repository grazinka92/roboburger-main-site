---
import AnimatedLogo from './AnimatedLogo.astro';

const nav = [
  { label: 'Home', href: '/' },
  { label: 'Product', href: '/our-product/' },
  { label: 'About Us', href: '/about/' },
  { label: 'Sweet Robo', href: 'https://sweetrobo.com/', external: true },
  { label: 'Invest', href: '/investor/' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="RoboBurger home">
      <AnimatedLogo />
    </a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: !item.external && path === item.href }]}
          {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact-us/" class="btn btn-primary nav-cta mobile-cta">Contact us</a>
    </nav>

    <a href="/contact-us/" class="btn btn-primary nav-cta desktop-cta">Contact us</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
  }
  .header-inner {
    display: grid;
    grid-template-columns: 20% 61.333% 18.667%;
    align-items: center;
    gap: 0;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0;
    min-height: 126px;
  }
  .logo { flex: none; display: block; height: 70px; margin: 0 0 6px 10px; justify-self: start; }
  .logo :global(svg) { height: 100%; width: auto; }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }
  .nav-link {
    position: relative;
    font-family: 'Poppins', system-ui, sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 20px;
    padding: 13px 20px;
    color: #000;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: #CF000C;
    opacity: 0;
  }
  .nav-link:hover { color: #CF000C; text-decoration: none; }
  .nav-link:hover::after, .nav-link.active::after { opacity: 1; }
  .nav-link.active { color: #CF000C; }
  .nav-cta {
    font-family: 'Poppins', system-ui, sans-serif;
    font-size: 18px;
    line-height: 18px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 20px;
    background: #FFDD54;
    color: #000;
    border: 0;
  }
  .nav-cta:hover { background: #FFDD54; color: #000; text-decoration: none; }
  .desktop-cta { flex: none; justify-self: end; margin-right: 18px; }
  .mobile-cta { display: none; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    height: 3px;
    width: 24px;
    background: var(--color-heading);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 900px) {
    .header-inner { display: flex; justify-content: space-between; min-height: 96px; }
    .nav-toggle { display: flex; }
    .desktop-cta { display: none; }
    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--color-white);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
      padding: 0.5rem 1rem 1rem;
      display: none;
    }
    .site-nav.open { display: flex; }
    .nav-link { padding: 0.75rem 0; border-bottom: 1px solid #eee; }
    .nav-link::after { display: none; }
    .mobile-cta { display: block; margin: 0.75rem 0 0; text-align: center; }
  }
</style>

<script>
  const btn = document.querySelector('.nav-toggle');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
